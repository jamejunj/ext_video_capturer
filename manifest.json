{
    "manifest_version": 3,
    "name": "Video Capturer",
    "description": "A HTML5 video image capturer for chrome",
    "version": "0.0.1",
    "action": {
      "default_popup": "popup/popup.html",
      "default_icon": "images/icon.png"
    },
    "icons": {
        "16": "images/icon.png",
        "32": "images/icon.png",
        "48": "images/icon.png",
        "128": "images/icon.png"
    },
    "content_scripts": [
        {
          "js": ["scripts/video_discovery.js"],
          "matches": [
            "<all_urls>"
          ]
        }
    ]
}