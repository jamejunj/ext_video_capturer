{
    "manifest_version": 3,
    "name": "Video Capturer",
    "description": "Capture the current frame of any HTML5 video on a page as a full-resolution PNG. Save or copy it to the clipboard in one click.",
    "version": "0.0.2",
    "action": {
      "default_popup": "popup/popup.html",
      "default_icon": {
        "16": "images/icon-16.png",
        "32": "images/icon-32.png",
        "48": "images/icon-48.png",
        "128": "images/icon-128.png"
      }
    },
    "icons": {
        "16": "images/icon-16.png",
        "32": "images/icon-32.png",
        "48": "images/icon-48.png",
        "128": "images/icon-128.png"
    },
    "content_scripts": [
        {
          "js": ["scripts/video_discovery.js"],
          "matches": [
            "<all_urls>"
          ]
        }
    ]
}